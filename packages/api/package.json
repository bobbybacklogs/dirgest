{
  "name": "@dirgest/api",
  "version": "0.1.1",
  "description": "Dirgest API server",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dirgest-api": "./bin/server.js"
  },
  "files": [
    "bin",
    "lib",
    "middleware",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "start": "node ./bin/server.js",
    "build:web": "cd ../web && npm run build",
    "copy:web": "node -e \"require('fs').cpSync('../web/dist','./dist',{recursive:true})\"",
    "prepublishOnly": "npm run build:web && npm run copy:web"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@dirgest/sdk": "0.1.1",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0"
  }
}
